# Definición de pipelines para el Host Agent
crisolweb:
  display_name: "Pipeline Crisolweb"
  timeout_minutes: 20
  pre_hook: "docker exec $(docker ps -qf 'name=openclaw-gateway') pkill -9 -f 'crisolweb-sync|chromium|playwright' || true"
  steps:
    - name: "1/3 Scrape Crisolweb"
      command: "docker exec $(docker ps -qf 'name=openclaw-gateway') bash /home/node/.openclaw/workspace/crisolweb-cron.sh"
      timeout_minutes: 15
    - name: "2/3 Generar SQL"
      command: "docker exec $(docker ps -qf 'name=openclaw-gateway') node /home/node/.openclaw/workspace/gen-upsert-sql.mjs"
      timeout_minutes: 5
    - name: "3/3 Sync Postgres"
      command: "bash /root/sync-postgres-from-host.sh"
      timeout_minutes: 3

siigo_saldos:
  display_name: "SIIGO Saldos Bancarios"
  timeout_minutes: 5
  steps:
    - name: "Sync SIIGO"
      command: "node /root/.hermes/scripts/siigo-saldos.js"
      timeout_minutes: 5
